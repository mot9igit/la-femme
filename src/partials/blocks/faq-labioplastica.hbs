<section class="section section--tinted faq" id="faq">
  <div class="dart-container">

    <div class="section__header faq__header">
      <div>
        <span class="section__eyebrow">{{faqLabioplastica.eyebrow}}</span>
        <h2>{{faqLabioplastica.title}}</h2>
      </div>
      <p class="section__desc">{{faqLabioplastica.text}}</p>
    </div>

    <div class="faq__layout">
      <div class="faq__list" data-accordion>
        {{#each faqLabioplastica.items}}
        <details class="faq__item"{{#if @index}}{{else}} open{{/if}}>
          <summary class="faq__question">
            <span>{{this.q}}</span>
            <i class="faq__toggle fa-solid fa-chevron-down" aria-hidden="true"></i>
          </summary>
          <div class="faq__answer">
            <p>{{this.a}}</p>
          </div>
        </details>
        {{/each}}
      </div>

      <aside class="faq__aside">
        <div class="faq__aside-card">
          <span class="faq__aside-icon"><i class="fa-solid fa-comments" aria-hidden="true"></i></span>
          <h3 class="faq__aside-title">{{faqLabioplastica.aside.title}}</h3>
          <p class="faq__aside-text">{{faqLabioplastica.aside.text}}</p>
          <div class="faq__aside-actions">
            <a href="tel:{{site.phoneHref}}" class="dart-btn dart-btn-primary dart-btn-block">
              <i class="fa-solid fa-phone" aria-hidden="true"></i> {{site.phone}}
            </a>
            <a href="{{site.whatsapp}}" class="dart-btn dart-btn-whatsapp dart-btn-block" target="_blank" rel="noopener">
              <i class="fa-brands fa-whatsapp" aria-hidden="true"></i> Написать в WhatsApp
            </a>
            <a href="{{site.telegram}}" class="dart-btn dart-btn-telegram dart-btn-block" target="_blank" rel="noopener">
              <i class="fa-brands fa-telegram" aria-hidden="true"></i> Написать в Telegram
            </a>
          </div>
        </div>

        <div class="faq__aside-note">
          <p>
            <i class="fa-solid fa-lightbulb" aria-hidden="true"></i>
            {{faqLabioplastica.aside.note}}
          </p>
        </div>
      </aside>
    </div>

  </div>
</section>
